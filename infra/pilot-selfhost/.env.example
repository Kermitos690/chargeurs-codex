POSTGRES_DB=chargeurs_pilot
POSTGRES_USER=chargeurs
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_VALUE

# Exact frontend origin(s) allowed to call the pilot API in a browser.
# Separate multiple origins with commas.
# Example while validating a Vercel preview:
# PILOT_ALLOWED_ORIGIN=https://example-preview.vercel.app
PILOT_ALLOWED_ORIGIN=

# ChargeNow read-only connectivity. Keep real credentials only in the local .env.
CHARGENOW_API_BASE_URL=https://developer.chargenow.top/cdb-open-api/v1
CHARGENOW_BASIC_USERNAME=
CHARGENOW_BASIC_PASSWORD=
# Preferred if already available: only the base64 token value, without the word Basic.
CHARGENOW_BASIC_AUTH=
CHARGENOW_TIMEOUT_MS=10000
MIN_RENTAL_BATTERY_PERCENT=20
