{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --no-audit --no-fund",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/cinematic-home.jpg",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Content-Type", "value": "image/jpeg" }
      ]
    },
    {
      "source": "/kiosk/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/kiosk/create-rental-session",
      "destination": "https://xqepbqnaenoeyfjkjnzl.supabase.co/functions/v1/create-rental-session"
    },
    {
      "source": "/api/kiosk/create-stripe-checkout",
      "destination": "https://xqepbqnaenoeyfjkjnzl.supabase.co/functions/v1/create-stripe-checkout"
    },
    {
      "source": "/api/kiosk/cabinet-snapshot",
      "destination": "https://xqepbqnaenoeyfjkjnzl.supabase.co/functions/v1/kiosk-cabinet-snapshot"
    },
    {
      "source": "/api/kiosk/reconcile-pending-ejection",
      "destination": "https://xqepbqnaenoeyfjkjnzl.supabase.co/functions/v1/reconcile-pending-ejection"
    },
    {
      "source": "/api/kiosk/return-summary",
      "destination": "https://xqepbqnaenoeyfjkjnzl.supabase.co/functions/v1/kiosk-return-summary"
    },
    {
      "source": "/api/kiosk/resume-state",
      "destination": "https://xqepbqnaenoeyfjkjnzl.supabase.co/functions/v1/kiosk-resume-state"
    },
    {
      "source": "/api/kiosk/customer-options",
      "destination": "https://xqepbqnaenoeyfjkjnzl.supabase.co/functions/v1/kiosk-customer-options"
    },
    {
      "source": "/api/kiosk/customer-pairing-create",
      "destination": "https://xqepbqnaenoeyfjkjnzl.supabase.co/functions/v1/customer-pairing-create"
    },
    {
      "source": "/api/kiosk/customer-pairing-status",
      "destination": "https://xqepbqnaenoeyfjkjnzl.supabase.co/functions/v1/customer-pairing-status"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
