# Environment: local | test | staging | production
APP_ENV=local
APP_VERSION=0.0.0-local
PUBLIC_APP_URL=https://app.example.invalid
PUBLIC_KIOSK_URL=https://app.example.invalid/kiosk
PUBLIC_ADMIN_URL=https://app.example.invalid/admin
ALLOWED_ORIGINS=https://app.example.invalid
SUPPORT_EMAIL=support@example.invalid

# Frontend public configuration
VITE_SUPABASE_PROJECT_ID=project-ref
VITE_SUPABASE_URL=https://project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_ROUTER_MODE=browser
VITE_APP_ENV=local
VITE_ENABLE_STRIPE_TERMINAL=false

# Supabase server/deployment configuration
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
SUPABASE_STAGING_PROJECT_ID=
SUPABASE_PRODUCTION_PROJECT_ID=

# Stripe test or live values must never be mixed in one deployed environment.
STRIPE_MODE=test
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TERMINAL_LOCATION_ID=
STRIPE_TERMINAL_READER_ID=
STRIPE_TERMINAL_ENABLED=false
STRIPE_CHECKOUT_SUCCESS_URL=https://app.example.invalid/pay/{CHECKOUT_SESSION_ID}/success
STRIPE_CHECKOUT_CANCEL_URL=https://app.example.invalid/pay/{CHECKOUT_SESSION_ID}/cancel

# ChargeNow — CHARGENOW_BASIC_AUTH is everything after "Basic ".
CHARGENOW_MODE=test
CHARGENOW_API_BASE_URL=https://developer.chargenow.top/cdb-open-api/v1
CHARGENOW_BASIC_AUTH=
CHARGENOW_BASIC_USERNAME=
CHARGENOW_BASIC_PASSWORD=
CHARGENOW_CALLBACK_SECRET=
CHARGENOW_TIMEOUT_MS=10000
# Leave empty until the provider confirms that slot=0 means auto-selection.
CHARGENOW_RENT_SLOT_ZERO_MODE=
CHARGENOW_MUTATIONS_ENABLED=false

# Internal signing, hashing and scheduled workers
INTERNAL_FUNCTION_SECRET=
PLATFORM_API_IP_HASH_SALT=
PLATFORM_WEBHOOK_SIGNING_SECRET=
PUBLIC_CONTACT_IP_HASH_SALT=
KIOSK_PUBLIC_BASE_URL=https://app.example.invalid

# Android build/provisioning (Gradle property equivalents are documented).
CHARGEURS_ENROLLMENT_URL=https://project-ref.supabase.co/functions/v1/kiosk-enroll
CHARGEURS_EJECTION_PUBLIC_KEY_BASE64=
ANDROID_UPDATE_CHANNEL=internal
ANDROID_KIOSK_MODE=true
ANDROID_TERMINAL_ENABLED=false
ANDROID_KEYSTORE_PATH=/secure/path/chargeurs-release.jks
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=chargeurs-kiosk
ANDROID_KEY_PASSWORD=

# Feature flags default closed until staging validation.
KIOSK_RENTALS_ENABLED=false
STRIPE_LIVE_ENABLED=false
LOCAL_HARDWARE_EJECTION_ENABLED=false
